{
	"name": "linstant_gourmand",
	"version": "1.0.0",
	"private": true,
	"license": "SEE LICENSE IN ../LICENSE.md",
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build && pnpm build:migrate",
		"start": "next start",
		"test": "vitest run",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"build:migrate": "esbuild src/common/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --log-level=warning",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env src/common/db/migrate.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.9",
		"@react-pdf/renderer": "^4.3.2",
		"@tanstack/react-query": "^5.90.26",
		"clsx": "^2.1.1",
		"csv-parse": "^6.1.0",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.1",
		"jose": "^6.2.1",
		"lucide-react": "^0.475.0",
		"next": "16.2.2",
		"pg": "^8.20.0",
		"rate-limiter-flexible": "^9.1.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/node": "^25.4.0",
		"@types/pg": "^8.18.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.2"
}
